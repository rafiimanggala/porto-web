# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# scene development scratch -- prototype variants and capture debris kept
# around during a scene's own build/iteration, never wired into a real page.
# Same exclusion list deploy.sh already rsyncs around; codified here so it
# doesn't have to be re-decided by hand at every commit.
/src/app/scene-lab/
/src/components/work/prototypes/
/src/app/work/health-platform/proto-*/
/public/icons/health/raw/
/frame_*.png
/wr-health.png
